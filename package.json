{
  "name": "cf-tosend-autoresponder",
  "version": "1.0.0",
  "description": "Lightweight open-source Email Autoresponder built on Cloudflare Workers, D1, and ToSend API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute autoresponder_db --remote --file=schema.sql",
    "d1:init:local": "wrangler d1 execute autoresponder_db --local --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0",
    "wrangler": "^3.84.1"
  }
}
