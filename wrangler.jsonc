{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-tosend-autoresponder",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "autoresponder_db",
      "database_id": "04b89bbf-3f65-4aef-aed2-4452879cc379"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  }
  // Secrets（不透過 vars 存放，請用 wrangler secret put 或 GitHub Secrets）：
  //   HAOJI_SECRET — AES-256 加密金鑰，至少 32 字元隨機字串（用來加密 ToSend API Key）
  // ToSend 寄信相關設定（API Key、寄件人、網域）一律在後台「設定」頁填寫，存於 D1 settings 表。
}
